# Copy to .env and fill in values
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASS=yourpassword
DB_NAME=geostats_agent1

# Who this agent is, and the peers it may ask (name=url, comma-separated).
AGENT_NAME=Agent-1
PEER_AGENTS=Agent-2=http://localhost:8001

# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Stage 1 (classification) and stage 2 (extraction) each pick their own
# OpenAI model — see agent1/pipeline/classifier.py and extractor.py. Both
# default to gpt-4o-mini if unset; a single /query request can further
# override both for just that call via UserQuery.model.
CLASSIFY_MODEL=gpt-4o-mini
EXTRACT_MODEL=gpt-4o-mini
