# Copy to .env and fill in values
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASS=yourpassword
DB_NAME=geostats_agent1

# Who this agent is, and the peers it may ask (name=url, comma-separated).
AGENT_NAME=Agent-1
PEER_AGENTS=Agent-2=http://localhost:8001

# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# The language model when a request does not choose one (an id from
# config/settings.yaml llm.models). The front end can pick any configured one.
LLM_DEFAULT=gpt-4o-mini

# Claude models: from https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...      (CLAUDE_API_KEY works too)

# Qwen3-8B with / without the QLoRA adapter: the openweight-llm service
# QWEN_HOST=http://<ec2-public-ip>
# QWEN_API_KEY=<API_KEY from the server's .env>
